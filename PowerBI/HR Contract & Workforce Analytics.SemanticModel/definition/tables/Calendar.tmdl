				    CALENDARAUTO(),
				    "year", YEAR([Date]),
				    "month_number", MONTH([Date]),
				    "month_name", "Tháng " & FORMAT(MONTH([Date]), "00")
				)

	annotation PBI_Id = 7b9352cc356047ddaae5ac6f42eb1e96

